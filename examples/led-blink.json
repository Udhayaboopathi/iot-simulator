  "files": [
    {
      "name": "sketch.ino",
      "language": "cpp",
      "content": "// Arduino LED blink — D13 drives an LED through a 220 ohm resistor.\nvoid setup() {\n  pinMode(D13, OUTPUT);\n  Serial.begin(9600);\n}\nvoid loop() {\n  digitalWrite(D13, HIGH);\n  Serial.println(\"LED ON\");\n  delay(1000);\n  digitalWrite(D13, LOW);\n  Serial.println(\"LED OFF\");\n  delay(1000);\n}\n"
    }
