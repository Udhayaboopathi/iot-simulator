  "files": [
    {
      "name": "sketch.ino",
      "language": "cpp",
      "content": "DHT dht(GPIO15, DHT22);\nvoid setup() { Serial.begin(115200); dht.begin(); mqtt.connect(); }\nvoid loop() {\n  float t = dht.readTemperature();\n  Serial.print(\"Publishing temp: \"); Serial.println(t);\n  mqtt.publish(\"iot/room1/temperature\", t);\n  delay(2000);\n}\n"
    }
