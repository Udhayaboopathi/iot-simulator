  "files": [
    {
      "name": "sketch.ino",
      "language": "cpp",
      "content": "void setup() { Serial.begin(9600); pinMode(D9, OUTPUT); pinMode(D10, INPUT); }\nvoid loop() {\n  digitalWrite(D9, LOW); delay(1);\n  digitalWrite(D9, HIGH); delay(1);\n  digitalWrite(D9, LOW);\n  long us = pulseIn(D10, HIGH);\n  long cm = us / 58;\n  Serial.print(\"Distance: \"); Serial.print(cm); Serial.println(\" cm\");\n  delay(500);\n}\n"
    }
