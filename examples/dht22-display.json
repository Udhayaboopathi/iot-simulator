      "name": "sketch.ino",
      "language": "cpp",
      "content": "DHT dht(D2, DHT22);\nvoid setup() { Serial.begin(9600); dht.begin(); }\nvoid loop() {\n  float t = dht.readTemperature();\n  float h = dht.readHumidity();\n  Serial.print(\"Temp: \"); Serial.print(t); Serial.print(\" C  Humidity: \"); Serial.print(h); Serial.println(\" %\");\n  delay(2000);\n}\n"
